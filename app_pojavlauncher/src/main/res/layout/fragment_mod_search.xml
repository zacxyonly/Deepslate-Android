<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingHorizontal="@dimen/fragment_padding_medium">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_mod_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_overlay"
        android:paddingHorizontal="@dimen/padding_medium"
        android:paddingVertical="@dimen/padding_small"
        android:layout_marginTop="@dimen/fragment_padding_medium"
        android:translationZ="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top row: Back button, Search input with clear button, Filter button -->
        <ImageButton
            android:id="@+id/search_mod_back"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:minWidth="@dimen/_38sdp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_arrow_back_white"
            android:paddingHorizontal="@dimen/padding_small"
            android:contentDescription="@string/profiles_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/search_bar_layout"
            app:layout_constraintBottom_toBottomOf="@id/search_bar_layout" />

        <FrameLayout
            android:id="@+id/search_bar_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_small"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/search_mod_back"
            app:layout_constraintEnd_toStartOf="@id/search_mod_filter">

            <EditText
                android:id="@+id/search_mod_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/_34sdp"
                android:background="@drawable/background_chip_selector"
                android:textSize="@dimen/_13ssp"
                android:ems="10"
                android:hint="@string/hint_search_content"
                android:textColor="@color/primary_text"
                android:textColorHint="#94a3b8"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="@dimen/padding_heavy"
                android:paddingEnd="@dimen/_32sdp"
                android:paddingVertical="@dimen/padding_small"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/search_mod_clear_btn"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/padding_small"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clear_white"
                android:visibility="gone"
                android:contentDescription="@string/search_mod_reset_filters"
                app:tint="#cbd5e1" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/search_mod_filter"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:minWidth="@dimen/_38sdp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_filter"
            android:paddingHorizontal="@dimen/padding_small"
            android:contentDescription="@string/filter_modloader"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/search_bar_layout"
            app:layout_constraintBottom_toBottomOf="@id/search_bar_layout" />

        <!-- Category selector bar -->
        <HorizontalScrollView
            android:id="@+id/search_category_scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/search_bar_layout">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/category_mods_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_28sdp"
                    android:gravity="center"
                    android:background="@drawable/background_tab_selector"
                    android:text="@string/category_mods"
                    android:textColor="#cbd5e1"
                    android:textSize="@dimen/_11ssp"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:paddingVertical="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/padding_small"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/category_resourcepacks_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_28sdp"
                    android:gravity="center"
                    android:background="@drawable/background_tab_selector"
                    android:text="@string/category_resourcepacks"
                    android:textColor="#cbd5e1"
                    android:textSize="@dimen/_11ssp"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:paddingVertical="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/padding_small"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/category_shaders_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_28sdp"
                    android:gravity="center"
                    android:background="@drawable/background_tab_selector"
                    android:text="@string/category_shaders"
                    android:textColor="#cbd5e1"
                    android:textSize="@dimen/_11ssp"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:paddingVertical="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/padding_small"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/category_modpacks_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_28sdp"
                    android:gravity="center"
                    android:background="@drawable/background_tab_selector"
                    android:text="@string/category_modpacks"
                    android:textColor="#cbd5e1"
                    android:textSize="@dimen/_11ssp"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:paddingVertical="@dimen/_5sdp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Filter Chips Row (Version & Loader) in Pojav background_line style -->
        <HorizontalScrollView
            android:id="@+id/search_filter_chips_scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/search_category_scrollview">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/search_mod_chip_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_24sdp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/background_chip_selector"
                    android:paddingHorizontal="@dimen/padding_small"
                    android:paddingVertical="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/padding_small"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/search_mod_chip_version_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/minebutton_color"
                        android:text="@string/search_mod_all_versions" />

                    <ImageView
                        android:id="@+id/search_mod_chip_version_clear"
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:src="@drawable/ic_clear_white"
                        android:visibility="gone"
                        android:layout_marginStart="@dimen/padding_tiny"
                        app:tint="#cbd5e1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/search_mod_chip_loader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_24sdp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/background_chip_selector"
                    android:paddingHorizontal="@dimen/padding_small"
                    android:paddingVertical="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/padding_small"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/search_mod_chip_loader_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_10ssp"
                        android:textColor="@color/minebutton_color"
                        android:text="@string/search_mod_all_loaders" />

                    <ImageView
                        android:id="@+id/search_mod_chip_loader_clear"
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:src="@drawable/ic_clear_white"
                        android:visibility="gone"
                        android:layout_marginStart="@dimen/padding_tiny"
                        app:tint="#cbd5e1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/search_mod_target_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="#cbd5e1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="@dimen/padding_small"
                    tools:text="Profile: (Default)" />

            </LinearLayout>
        </HorizontalScrollView>

        <ProgressBar
            android:id="@+id/search_mod_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginTop="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/search_filter_chips_scrollview" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_mod_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/_15sdp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Empty state with Pojav / Deepslate MineButton style -->
    <LinearLayout
        android:id="@+id/search_mod_empty_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/padding_large"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/search_mod_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_mod_no_results_title"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/search_mod_empty_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_mod_no_results_desc"
            android:textColor="#cbd5e1"
            android:textSize="@dimen/_11ssp"
            android:gravity="center"
            android:layout_marginTop="@dimen/padding_small" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/search_mod_btn_search_all_versions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_mod_search_all_versions"
            android:textColor="@color/primary_text"
            android:paddingHorizontal="@dimen/padding_large"
            android:layout_marginTop="@dimen/padding_medium" />

        <Button
            android:id="@+id/search_mod_btn_reset_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/_28sdp"
            android:minWidth="0dp"
            android:background="@drawable/background_chip_selector"
            android:text="@string/search_mod_reset_filters"
            android:textColor="#cbd5e1"
            android:textSize="@dimen/_11ssp"
            android:textAllCaps="false"
            android:paddingHorizontal="@dimen/padding_large"
            android:paddingVertical="@dimen/_5sdp"
            android:layout_marginTop="@dimen/padding_small" />

    </LinearLayout>

    <TextView
        android:id="@+id/search_mod_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
