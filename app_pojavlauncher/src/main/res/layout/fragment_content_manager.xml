<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingHorizontal="@dimen/fragment_padding_medium">

    <!-- Top Overlay: Back, Search, Shortcuts, Profile Spinner, Categories, Summary -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/manager_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_overlay"
        android:paddingHorizontal="@dimen/padding_medium"
        android:paddingVertical="@dimen/padding_small"
        android:layout_marginTop="@dimen/fragment_padding_medium"
        android:translationZ="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Row: Back, Search Bar, Download Shortcut, Folder Shortcut -->
        <ImageButton
            android:id="@+id/manager_back"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:minWidth="@dimen/_38sdp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_arrow_back_white"
            android:paddingHorizontal="@dimen/padding_small"
            android:contentDescription="@string/profiles_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/manager_search_bar_layout"
            app:layout_constraintBottom_toBottomOf="@id/manager_search_bar_layout" />

        <FrameLayout
            android:id="@+id/manager_search_bar_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_small"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/manager_back"
            app:layout_constraintEnd_toStartOf="@id/manager_btn_download">

            <EditText
                android:id="@+id/manager_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/_36sdp"
                android:background="@drawable/background_line"
                android:textSize="@dimen/_13ssp"
                android:ems="10"
                android:hint="@string/manager_search_hint"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/secondary_text"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="@dimen/padding_heavy"
                android:paddingEnd="@dimen/_32sdp"
                android:paddingVertical="@dimen/padding_small"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/manager_clear_btn"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/padding_small"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clear_white"
                android:visibility="gone"
                android:contentDescription="@string/search_mod_reset_filters"
                app:tint="@color/subtext_color" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/manager_btn_download"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:minWidth="@dimen/_36sdp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_download"
            android:paddingHorizontal="@dimen/padding_small"
            android:contentDescription="@string/manager_btn_download"
            app:tint="@color/minebutton_color"
            app:layout_constraintEnd_toStartOf="@id/manager_btn_folder"
            app:layout_constraintTop_toTopOf="@id/manager_search_bar_layout"
            app:layout_constraintBottom_toBottomOf="@id/manager_search_bar_layout" />

        <ImageButton
            android:id="@+id/manager_btn_folder"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:minWidth="@dimen/_36sdp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_folder"
            android:paddingHorizontal="@dimen/padding_small"
            android:contentDescription="@string/manager_btn_open_folder"
            app:tint="@color/primary_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/manager_search_bar_layout"
            app:layout_constraintBottom_toBottomOf="@id/manager_search_bar_layout" />

        <!-- Row 2: Profile Selector Row -->
        <LinearLayout
            android:id="@+id/manager_profile_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/manager_search_bar_layout">

            <TextView
                android:id="@+id/manager_profile_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manager_profile_label"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                android:layout_marginEnd="@dimen/padding_small" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/manager_profile_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/_34sdp"
                android:background="@drawable/background_line" />

        </LinearLayout>

        <!-- Row 3: Category Selector Bar -->
        <HorizontalScrollView
            android:id="@+id/manager_category_scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/manager_profile_container">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/category_mods_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_32sdp"
                    android:text="@string/category_mods"
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/primary_text"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:layout_marginEnd="@dimen/padding_small" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/category_resourcepacks_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_32sdp"
                    android:text="@string/category_resourcepacks"
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/primary_text"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:layout_marginEnd="@dimen/padding_small" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/category_shaders_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_32sdp"
                    android:text="@string/category_shaders"
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/primary_text"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:layout_marginEnd="@dimen/padding_small" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/category_modpacks_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_32sdp"
                    android:text="@string/category_modpacks"
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/primary_text"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:layout_marginEnd="@dimen/padding_small" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/category_maps_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_32sdp"
                    android:text="@string/category_maps"
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/primary_text"
                    android:paddingHorizontal="@dimen/padding_medium" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Row 4: Summary Counter & Import Button -->
        <LinearLayout
            android:id="@+id/manager_summary_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/manager_category_scrollview">

            <TextView
                android:id="@+id/manager_summary_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/subtext_color"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="12 mod terpasang (10 aktif)" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/manager_btn_import"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/_28sdp"
                android:textSize="@dimen/_11ssp"
                android:text="@string/manager_btn_import"
                android:textColor="@color/primary_text"
                android:paddingHorizontal="@dimen/padding_medium" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/manager_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginTop="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/manager_summary_row" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/manager_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/_15sdp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/manager_empty_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/padding_large"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/manager_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            tools:text="Belum Ada Mod Terpasang" />

        <TextView
            android:id="@+id/manager_empty_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/subtext_color"
            android:textSize="@dimen/_12ssp"
            android:gravity="center"
            android:layout_marginTop="@dimen/padding_small"
            tools:text="Folder mods untuk versi ini masih kosong." />

        <com.kdt.mcgui.MineButton
            android:id="@+id/manager_empty_download_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manager_btn_download"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_12ssp"
            android:paddingHorizontal="@dimen/padding_large"
            android:layout_marginTop="@dimen/padding_medium" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
