<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_mod_card"
    android:paddingHorizontal="@dimen/padding_medium"
    android:paddingVertical="@dimen/padding_medium"
    android:layout_marginVertical="@dimen/padding_small">

    <!-- Mod Thumbnail -->
    <ImageView
        android:id="@+id/mod_thumbnail_imageview"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@mipmap/ic_launcher_foreground" />

    <!-- Source Platform (Modrinth / CurseForge) -->
    <ImageView
        android:id="@+id/mod_source_imageview"
        android:layout_width="@dimen/_13sdp"
        android:layout_height="@dimen/_13sdp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_modrinth" />

    <!-- Title -->
    <TextView
        android:id="@+id/mod_title_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold"
        android:layout_marginStart="@dimen/padding_moderate"
        app:layout_constraintEnd_toStartOf="@+id/mod_source_imageview"
        app:layout_constraintStart_toEndOf="@+id/mod_thumbnail_imageview"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Sodium" />

    <!-- Meta row: Author & Downloads -->
    <TextView
        android:id="@+id/mod_meta_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/minebutton_color"
        android:textSize="@dimen/_10ssp"
        android:layout_marginStart="@dimen/padding_moderate"
        app:layout_constraintEnd_toStartOf="@+id/mod_source_imageview"
        app:layout_constraintStart_toEndOf="@+id/mod_thumbnail_imageview"
        app:layout_constraintTop_toBottomOf="@id/mod_title_textview"
        tools:text="By jellysquid3 • 42.5M downloads" />

    <!-- Description -->
    <TextView
        android:id="@+id/mod_body_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="#cbd5e1"
        android:textSize="@dimen/_11ssp"
        android:layout_marginStart="@dimen/padding_moderate"
        android:layout_marginEnd="@dimen/padding_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mod_thumbnail_imageview"
        app:layout_constraintTop_toBottomOf="@+id/mod_meta_textview"
        tools:text="A modern rendering engine for Minecraft that greatly improves frame rates and reduces stutter." />

    <!-- ViewStub for extended details -->
    <ViewStub
        android:id="@+id/mod_limited_state_stub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout="@layout/view_mod_extended"
        android:layout_marginTop="@dimen/padding_medium"
        app:layout_constraintTop_toBottomOf="@id/mod_thumbnail_imageview" />

</androidx.constraintlayout.widget.ConstraintLayout>
