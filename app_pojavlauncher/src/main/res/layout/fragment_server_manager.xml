<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingHorizontal="@dimen/fragment_padding_medium">

    <!-- Top Overlay Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/server_manager_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_overlay"
        android:paddingHorizontal="@dimen/padding_medium"
        android:paddingVertical="@dimen/padding_small"
        android:layout_marginTop="@dimen/fragment_padding_medium"
        android:translationZ="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/server_manager_back"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:minWidth="@dimen/_38sdp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_arrow_back_white"
            android:paddingHorizontal="@dimen/padding_small"
            android:contentDescription="@string/profiles_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:id="@+id/server_manager_title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/padding_small"
            android:layout_marginEnd="@dimen/padding_small"
            app:layout_constraintStart_toEndOf="@id/server_manager_back"
            app:layout_constraintEnd_toStartOf="@id/server_manager_btn_refresh"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/server_manager_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_manager_title"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/server_manager_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/_10ssp"
                tools:text="3 Server tersimpan" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/server_manager_btn_refresh"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_custom_controls"
            app:tint="@color/primary_text"
            android:contentDescription="@string/server_status_pinging"
            android:layout_marginEnd="@dimen/padding_tiny"
            app:layout_constraintEnd_toStartOf="@id/server_manager_btn_add"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/server_manager_btn_add"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add"
            app:tint="@color/minebutton_color"
            android:contentDescription="@string/server_manager_add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/server_manager_progressbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Server List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/server_manager_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/fragment_padding_medium" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/server_manager_empty_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="@dimen/_56sdp"
            android:layout_height="@dimen/_56sdp"
            android:src="@drawable/ic_menu_custom_controls"
            app:tint="@color/secondary_text" />

        <TextView
            android:id="@+id/server_manager_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:text="@string/server_manager_empty"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/server_manager_empty_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:minHeight="@dimen/_32sdp"
            android:textColor="@color/minebutton_color"
            android:textSize="@dimen/_12ssp"
            android:text="@string/server_manager_add" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
