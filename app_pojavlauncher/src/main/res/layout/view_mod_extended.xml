<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/_6sdp"
    android:layout_marginTop="@dimen/_4sdp">

    <!-- Subtle divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#242c38"
        android:layout_marginBottom="@dimen/_6sdp" />

    <TextView
        android:id="@+id/mod_extended_error_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_modpack_download_error"
        android:textColor="#f87171"
        android:textSize="@dimen/_9ssp"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/_4sdp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_mod_select_version_label"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/_9ssp"
        android:layout_marginBottom="@dimen/_2sdp" />

    <androidx.appcompat.widget.AppCompatSpinner
        android:id="@+id/mod_extended_version_spinner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_28sdp"
        android:background="@drawable/background_rounded_spinner"
        android:paddingHorizontal="@dimen/padding_medium"
        android:layout_marginBottom="@dimen/_6sdp" />

    <Button
        android:id="@+id/mod_extended_select_version_button"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_28sdp"
        android:background="@drawable/background_install_btn"
        android:text="@string/search_mod_install"
        android:textColor="#0f1216"
        android:textSize="@dimen/_10ssp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:enabled="false" />

</LinearLayout>
